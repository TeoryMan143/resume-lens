@startuml T_C_PLUS_PLUS
hide empty description
left to right direction
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam state {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
title T_C_PLUS_PLUS: {c++, cpp} → C_PLUS_PLUS

state q0
state q1
state q2
state q3
state q4
state q5
state qF #E8F5E9 ##[bold]2E7D32

[*] --> q0
q0 --> q1 : c / ε
q1 --> q2 : + / ε
q1 --> q4 : p / ε
q2 --> q3 : + / ε
q3 --> qF : ε / C_PLUS_PLUS
q4 --> q5 : p / ε
q5 --> qF : ε / C_PLUS_PLUS
qF --> [*]
@enduml
