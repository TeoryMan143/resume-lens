@startuml T_CI_CD
hide empty description
left to right direction
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam state {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
title T_CI_CD: {cicd} → CI_CD

state q0
state q1
state q2
state q3
state q4
state qF #E8F5E9 ##[bold]2E7D32

[*] --> q0
q0 --> q1 : c / ε
q1 --> q2 : i / ε
q2 --> q3 : c / ε
q3 --> q4 : d / ε
q4 --> qF : ε / CI_CD
qF --> [*]
@enduml
