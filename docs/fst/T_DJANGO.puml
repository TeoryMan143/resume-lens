@startuml T_DJANGO
hide empty description
left to right direction
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam state {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
title T_DJANGO: {django} → DJANGO

state q0
state q1
state q2
state q3
state q4
state q5
state q6
state qF #E8F5E9 ##[bold]2E7D32

[*] --> q0
q0 --> q1 : d / ε
q1 --> q2 : j / ε
q2 --> q3 : a / ε
q3 --> q4 : n / ε
q4 --> q5 : g / ε
q5 --> q6 : o / ε
q6 --> qF : ε / DJANGO
qF --> [*]
@enduml
