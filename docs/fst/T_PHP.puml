@startuml T_PHP
hide empty description
left to right direction
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam state {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
title T_PHP: {php} → PHP

state q0
state q1
state q2
state q3
state qF #E8F5E9 ##[bold]2E7D32

[*] --> q0
q0 --> q1 : p / ε
q1 --> q2 : h / ε
q2 --> q3 : p / ε
q3 --> qF : ε / PHP
qF --> [*]
@enduml
