@startuml T_EXPRESS
hide empty description
left to right direction
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam state {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
title T_EXPRESS: {expressjs} → EXPRESS

state q0
state q1
state q2
state q3
state q4
state q5
state q6
state q7
state q8
state q9
state qF #E8F5E9 ##[bold]2E7D32

[*] --> q0
q0 --> q1 : e / ε
q1 --> q2 : x / ε
q2 --> q3 : p / ε
q3 --> q4 : r / ε
q4 --> q5 : e / ε
q5 --> q6 : s / ε
q6 --> q7 : s / ε
q7 --> q8 : j / ε
q8 --> q9 : s / ε
q9 --> qF : ε / EXPRESS
qF --> [*]
@enduml
