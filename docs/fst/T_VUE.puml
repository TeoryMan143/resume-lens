@startuml T_VUE
hide empty description
left to right direction
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam state {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
title T_VUE: {vue, vuejs} → VUE

state q0
state q1
state q2
state q3
state q4
state q5
state qF #E8F5E9 ##[bold]2E7D32

[*] --> q0
q0 --> q1 : v / ε
q1 --> q2 : u / ε
q2 --> q3 : e / ε
q3 --> q4 : j / ε
q3 --> qF : ε / VUE
q4 --> q5 : s / ε
q5 --> qF : ε / VUE
qF --> [*]
@enduml
