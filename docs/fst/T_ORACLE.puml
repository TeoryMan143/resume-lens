left to right direction
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam state {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
title T_ORACLE: {oracle} → ORACLE

state q0
state q1
state q2
state q3
state q4
state q5
state q6
