@startuml T_PYTORCH
hide empty description
left to right direction
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam state {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
title T_PYTORCH: {pytorch} → PYTORCH

state q0
state q1
state q2
state q3
state q4
state q5
state q6
state q7
state qF #E8F5E9 ##[bold]2E7D32

[*] --> q0
q0 --> q1 : p / ε
q1 --> q2 : y / ε
q2 --> q3 : t / ε
q3 --> q4 : o / ε
q4 --> q5 : r / ε
q5 --> q6 : c / ε
q6 --> q7 : h / ε
q7 --> qF : ε / PYTORCH
qF --> [*]
@enduml
