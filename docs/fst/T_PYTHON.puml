@startuml T_PYTHON
hide empty description
left to right direction
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam state {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
title T_PYTHON: {python, python3} → PYTHON

state q0
state q1
state q2
state q3
state q4
state q5
state q6
state q7
state qF #E8F5E9 ##[bold]2E7D32

[*] --> q0
q0 --> q1 : p / ε
q1 --> q2 : y / ε
q2 --> q3 : t / ε
q3 --> q4 : h / ε
q4 --> q5 : o / ε
q5 --> q6 : n / ε
q6 --> q7 : 3 / ε
q6 --> qF : ε / PYTHON
q7 --> qF : ε / PYTHON
qF --> [*]
@enduml
