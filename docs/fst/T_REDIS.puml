@startuml T_REDIS
hide empty description
left to right direction
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam state {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
title T_REDIS: {redis} → REDIS

state q0
state q1
state q2
state q3
state q4
state q5
state qF #E8F5E9 ##[bold]2E7D32

[*] --> q0
q0 --> q1 : r / ε
q1 --> q2 : e / ε
q2 --> q3 : d / ε
q3 --> q4 : i / ε
q4 --> q5 : s / ε
q5 --> qF : ε / REDIS
qF --> [*]
@enduml
