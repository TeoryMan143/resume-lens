@startuml MACHINE_LEARNING_ENGINEER
hide empty description
left to right direction
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam state {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
title MACHINE_LEARNING_ENGINEER: DFA, 6 states, accepting state q5

state q0
state q1
state q2
state q3
state q4
state q5 #E8F5E9 ##[bold]2E7D32

[*] --> q0
q0 --> q1 : <b>R1</b> (LANGUAGE)\nPYTHON
q1 --> q1 : R1
q1 --> q2 : <b>R2</b> (DATA_PROCESSING)\nPANDAS, NUMPY
q2 --> q2 : R2 ∪ {DATA_PIPELINES}
q2 --> q3 : <b>R3</b> (ML_FRAMEWORK)\nSCIKIT_LEARN, TENSORFLOW, PYTORCH
q3 --> q3 : R3 ∪ {KERAS, ML_MODEL_DEVELOPMENT,\nDEEP_LEARNING}
q3 --> q4 : <b>R4</b> (DATABASE)\nSQL_DB
q4 --> q4 : R4 ∪ NOSQL_DB
q4 --> q5 : <b>R5</b> (VERSION_CONTROL)\nGIT_TOOLS
q5 --> q5 : R5
q5 --> [*]
@enduml
