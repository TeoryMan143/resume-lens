@startuml DEVOPS_ENGINEER
hide empty description
left to right direction
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam state {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
title DEVOPS_ENGINEER: DFA, 7 states, accepting state q6

state q0
state q1
state q2
state q3
state q4
state q5
state q6 #E8F5E9 ##[bold]2E7D32

[*] --> q0
q0 --> q1 : <b>R1</b> (OS_SCRIPTING)\nLINUX, BASH
q1 --> q1 : R1 ∪ {PYTHON}
q1 --> q2 : <b>R2</b> (VERSION_CONTROL)\nGIT_TOOLS
q2 --> q2 : R2
q2 --> q3 : <b>R3</b> (CI_CD)\nCI_CD, JENKINS, GITHUB_ACTIONS
q3 --> q3 : R3
q3 --> q4 : <b>R4</b> (CONTAINERS)\nDOCKER, KUBERNETES
q4 --> q4 : R4
q4 --> q5 : <b>R5</b> (INFRASTRUCTURE_AS_CODE)\nINFRASTRUCTURE_AS_CODE, TERRAFORM, ANSIBLE
q5 --> q5 : R5
q5 --> q6 : <b>R6</b> (CLOUD)\nCLOUD
q6 --> q6 : R6 ∪ {PROMETHEUS, GRAFANA}
q6 --> [*]
@enduml
